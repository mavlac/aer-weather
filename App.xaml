<?xml version="1.0" encoding="utf-8"?>
<Application
	x:Class="Aer.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Aer">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
				<!-- Other merged dictionaries here -->
			</ResourceDictionary.MergedDictionaries>
			
			<!-- App -->
			<!-- AppName: Package.Current.DisplayName -->
			<x:String x:Key="AppDescription">A minimalistic WinUI 3 weather app for Windows</x:String>
			<x:String x:Key="StoreID">9NFLN708XZLH</x:String>
			<x:String x:Key="WebStoreURL">https://apps.microsoft.com/detail/9NFLN708XZLH</x:String>
			
			<!-- Other app resources here -->
			<FontFamily x:Key="WeatherIconsFont">ms-appx:///Assets/Fonts/weathericons-regular-webfont.ttf#Weather Icons</FontFamily>
			<FontFamily x:Key="FluentIconsFont">ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>
			
			<!--  Constants  -->
			<x:String x:Key="GitHubRepositoryURL">https://github.com/mavlac/aer-weather</x:String>
			<x:String x:Key="PrivacyStatementURL">https://github.com/mavlac/aer-weather/blob/main/PRIVACY.md</x:String>
			
			<!--  Breakpoints  -->
			<x:Double x:Key="Breakpoint1008Plus">1008</x:Double>
			<x:Double x:Key="Breakpoint840Plus">840</x:Double>
			<x:Double x:Key="Breakpoint641Plus">641</x:Double>
			<!--  Layout  -->
			<x:Double x:Key="NavPaneNarrowWidth">160</x:Double>
			
			<!-- Color Theme -->
			<Color x:Key="AerAccentColorDarkGray">#FF202020</Color>
			<Color x:Key="AerAccentColorMediumGray">#FF909090</Color>
			<Color x:Key="AerAccentColorLightGray">#FFE0E0E0</Color>
		</ResourceDictionary>
	</Application.Resources>
</Application>
