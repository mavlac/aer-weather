<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Aer.SettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Aer"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:ui="using:CommunityToolkit.WinUI"
	xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	mc:Ignorable="d">

	<Page.Resources>
		<!--  These styles can be referenced to create a consistent SettingsPage layout  -->

		<!--  Style (inc. the correct spacing) of a section header  -->
		<Style x:Key="SettingsSectionHeaderTextBlockStyle"
			   BasedOn="{StaticResource BodyStrongTextBlockStyle}"
			   TargetType="TextBlock">
			<Style.Setters>
				<Setter Property="Margin" Value="1,30,0,6" />
			</Style.Setters>
		</Style>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<TextBlock x:Name="HeaderText"
				   Margin="24,24,24,0"
				   Style="{StaticResource SubtitleTextBlockStyle}"
				   Text="Settings" />
		<ScrollViewer x:Name="Scroller"
					  Grid.Row="1"
					  Padding="24,0,24,0">
			<Grid Padding="0,0,0,12">
				<StackPanel HorizontalAlignment="Stretch" Spacing="4">
					
					<TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
							   Text="Location" />
					
					<controls:SettingsCard x:Name="LocationSettingsCard"
										   Header="LocationSettingsCard.Header"
										   Description="LocationSettingsCard.Description"
										   HeaderIcon="Map">
						<StackPanel Orientation="Horizontal">
							<ProgressRing x:Name="LocationLoadingProgressRing"
										  IsActive="False"
										  Background="Transparent"
										  Width="18"
										  Height="18"
										  Margin="0,0,8,0"/>
							<AutoSuggestBox x:Name="LocationAutoSuggestBox"
										TextChanged="LocationAutoSuggestBox_TextChanged"
										SuggestionChosen="LocationAutoSuggestBox_SuggestionChosen"
										PlaceholderText="Type a location"
										Width="280">
								<TeachingTip
									x:Name="LocationAutoSuggestBoxTeachingTip"
									Title="Find your city"
									Subtitle="Begin typing a city name to see suggestions"
									Target="{x:Bind LocationAutoSuggestBox}"
									IsOpen="False"
									IsLightDismissEnabled="True">
									<TeachingTip.IconSource>
										<SymbolIconSource Symbol="Keyboard" />
									</TeachingTip.IconSource>
								</TeachingTip>
							</AutoSuggestBox>
						</StackPanel>
					</controls:SettingsCard>
					
					<TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
							   Text="Appearance &amp; behavior" />
					
					<controls:SettingsCard Header="Units"
										   Description="Show temperature measurements in">
						<controls:SettingsCard.HeaderIcon>
							<FontIcon Glyph="&#xECC6;" /><!-- Unit (Ruler) Icon -->
						</controls:SettingsCard.HeaderIcon>
						<controls:Segmented Name="TempUnitSelector"
											SelectionChanged="TempUnitSelector_SelectionChanged"
											HorizontalAlignment="Stretch"
											SelectionMode="Single"
											Width="200">
							<controls:SegmentedItem Name="TempUnitCelsius" Content="Celsius" />
							<controls:SegmentedItem Name="TempUnitFahrenheit" Content="Fahrenheit" />
						</controls:Segmented>
					</controls:SettingsCard>
					
					<controls:SettingsCard Header="App theme"
										   Description="Select which app theme to display" >
						<controls:SettingsCard.HeaderIcon>
							<FontIcon Glyph="&#xF0224;" FontFamily="{StaticResource FluentIconsFont}" Width="32" Height="32" FontSize="32" /><!-- Brush Icon -->
						</controls:SettingsCard.HeaderIcon>
						<ComboBox x:Name="AppThemeSelector"
								  SelectionChanged="AppThemeSelector_SelectionChanged"
								  Width="200">
							<ComboBoxItem Name="AppThemeLight" Content="Light" Tag="Light" />
							<ComboBoxItem Name="AppThemeDark" Content="Dark" Tag="Dark" />
							<ComboBoxItem Name="AppThemeDefault" Content="Use system setting" Tag="Default" />
						</ComboBox>
					</controls:SettingsCard>
					
					<controls:SettingsCard Header="Accent Color"
										   Description="See your change the next time you start the app." >
						<controls:SettingsCard.HeaderIcon>
							<FontIcon Glyph="&#xE790;" /><!-- Color (Palette) Icon -->
						</controls:SettingsCard.HeaderIcon>
						<ComboBox x:Name="AccentColorSelector"
								  SelectionChanged="AccentColorSelector_SelectionChanged"
								  Width="200">
							<ComboBoxItem Name="AccentColorAer" Content="Monochrome (default)" Tag="False" />
							<ComboBoxItem Name="AccentColorSystem" Content="Use system setting" Tag="True" />
						</ComboBox>
					</controls:SettingsCard>

					<controls:SettingsCard Header="Thicker line"
										   Description="Use a bolder line style for the chart.">
						<controls:SettingsCard.HeaderIcon>
							<FontIcon Glyph="&#xE771;" />
							<!-- Personalize Icon -->
						</controls:SettingsCard.HeaderIcon>
						<ToggleSwitch x:Name="ThickLineToggle"
									  IsOn="{x:Bind IsThickLineEnabled, Mode=TwoWay}"
									  OnContent="Thick"
									  OffContent="Thin"/>
					</controls:SettingsCard>
					
					<TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
							   Text="About" />
					
					<controls:SettingsExpander Header="{x:Bind AppName}"
											   Description="{x:Bind Copyright}"
											   IsExpanded="False">
						<controls:SettingsExpander.HeaderIcon>
							<BitmapIcon ShowAsMonochrome="False"
										UriSource="ms-appx:///Assets/StoreLogo.png" />
						</controls:SettingsExpander.HeaderIcon>
						<TextBlock win:IsTextSelectionEnabled="True"
								   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								   Text="{x:Bind AppVersion}" />
						<controls:SettingsExpander.Items>
							<controls:SettingsCard Click="HyperlinkSettingsCard_Click"
												   IsClickEnabled="True"
												   Header="GitHub repository"
												   DataContext="{StaticResource GitHubRepositoryUrl}">
								<controls:SettingsCard.ActionIcon>
									<FontIcon Glyph="&#xE8A7;" /><!-- OpenInNewWindow Icon -->
								</controls:SettingsCard.ActionIcon>
							</controls:SettingsCard>
							<controls:SettingsCard Click="HyperlinkSettingsCard_Click"
												   IsClickEnabled="True"
												   Header="Privacy statement"
												   DataContext="{StaticResource PrivacyStatementUrl}">
								<controls:SettingsCard.ActionIcon>
									<FontIcon Glyph="&#xE8A7;" /><!-- OpenInNewWindow Icon -->
								</controls:SettingsCard.ActionIcon>
							</controls:SettingsCard>
							<controls:SettingsCard HorizontalContentAlignment="Left"
												   ContentAlignment="Vertical"
												   Header="References &amp; Resources">
								<StackPanel Margin="-12,0,0,0"
											Orientation="Vertical">
									<HyperlinkButton Click="HyperlinkButton_Click">
										<TextBlock Text="Open-Meteo weather API"
												   TextDecorations="Underline"
												   DataContext="https://open-meteo.com/"/>
									</HyperlinkButton>
									<HyperlinkButton Click="HyperlinkButton_Click">
										<TextBlock Text="GeoNames Geographical Database"
												   TextDecorations="Underline"
												   DataContext="https://www.geonames.org/"/>
									</HyperlinkButton>
									<HyperlinkButton Click="HyperlinkButton_Click">
										<TextBlock Text="Weather Icons"
												   TextDecorations="Underline"
												   DataContext="https://github.com/erikflowers/weather-icons"/>
									</HyperlinkButton>
									<HyperlinkButton Click="HyperlinkButton_Click">
										<TextBlock Text="Fluent UI System Icons"
												   TextDecorations="Underline"
												   DataContext="https://github.com/microsoft/fluentui-system-icons"/>
									</HyperlinkButton>
								</StackPanel>
							</controls:SettingsCard>
							<controls:SettingsCard HorizontalContentAlignment="Left"
												   ContentAlignment="Vertical"
												   Header="Dependencies">
								<StackPanel Margin="-12,0,0,0"
											Orientation="Vertical">
									<HyperlinkButton Click="HyperlinkButton_Click">
										<TextBlock Text="Win2D"
												   TextDecorations="Underline"
												   DataContext="https://github.com/microsoft/Win2D/"/>
									</HyperlinkButton>
									<HyperlinkButton Click="HyperlinkButton_Click">
										<TextBlock Text="Windows Community Toolkit"
												   TextDecorations="Underline"
												   DataContext="https://github.com/CommunityToolkit/Windows"/>
									</HyperlinkButton>
									<HyperlinkButton Click="HyperlinkButton_Click">
										<TextBlock Text="Windows App SDK"
												   TextDecorations="Underline"
												   DataContext="https://github.com/microsoft/WindowsAppSDK"/>
									</HyperlinkButton>
								</StackPanel>
							</controls:SettingsCard>
							<controls:SettingsCard HorizontalContentAlignment="Left"
												   ContentAlignment="Vertical"
												   Header="Debug info">
								<StackPanel Margin="-12,0,0,0"
											Orientation="Vertical">
									<TextBlock win:IsTextSelectionEnabled="True"
											   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
											   Text="{x:Bind WindowSizeInfoText()}"
											   Padding="12,8,0,8"/>
									<HyperlinkButton Content="Open app local folder"
													 Click="OpenAppLocalFolderButton_Click" />
									<HyperlinkButton Content="Reset all data and settings"
													 Click="ClearLocalSettingsButton_Click" />
								</StackPanel>
							</controls:SettingsCard>
						</controls:SettingsExpander.Items>
					</controls:SettingsExpander>
				</StackPanel>
			</Grid>
		</ScrollViewer>
	</Grid>
</Page>
