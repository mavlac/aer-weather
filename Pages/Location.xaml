<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Aer.Pages.Location"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<TextBlock x:Name="HeaderText"
			Margin="24,24,24,0"
			Style="{StaticResource SubtitleTextBlockStyle}"
			Text="Location" />
		<ScrollViewer x:Name="Scroller"
					  Grid.Row="1"
					  Padding="24,0,24,0">
			<Grid Padding="0,0,0,14">
				<StackPanel HorizontalAlignment="Stretch" Spacing="4">

					<TextBlock x:Name="SectionHeaderText"
							   Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
							   Text="Find a location"/>

					<controls:SettingsCard x:Name="LocationSettingsCard"
										   Header="LocationSettingsCard.Header"
										   Description="LocationSettingsCard.Description"
										   HeaderIcon="Map">
						<StackPanel Orientation="Horizontal">
							<ProgressRing x:Name="LocationLoadingProgressRing"
										  IsActive="False"
										  Background="Transparent"
										  Width="18"
										  Height="18"
										  Margin="0,0,8,0"/>
							<AutoSuggestBox x:Name="LocationAutoSuggestBox"
										    TextChanged="LocationAutoSuggestBox_TextChanged"
										    SuggestionChosen="LocationAutoSuggestBox_SuggestionChosen"
										    PlaceholderText="Type a location"
										    Width="280">
								<TeachingTip
									x:Name="LocationAutoSuggestBoxTeachingTip"
									Title="Find your city"
									Subtitle="Begin typing to see suggestions"
									Target="{x:Bind LocationAutoSuggestBox}"
									IsOpen="False"
									IsLightDismissEnabled="True">
									<TeachingTip.IconSource>
										<FontIconSource Glyph="&#xE92E;" /><!-- KeyboardStandard Icon -->
									</TeachingTip.IconSource>
								</TeachingTip>
							</AutoSuggestBox>
							<Button x:Name="UseCurrentLocationButton"
									Click="UseCurrentLocationButton_Click"
									Margin="4,0,0,0"
									Padding="2,2,2,2"
									VerticalAlignment="Center"
									HorizontalAlignment="Center"
									Height="32"
									Width="36"
									ToolTipService.ToolTip="Estimate your current location from your IP address">
								<FontIcon Glyph="&#xE81D;" FontSize="14"/><!-- Location Icon -->
							</Button>
						</StackPanel>
					</controls:SettingsCard>


					<TextBlock x:Name="RecentLocationsSectionHeaderText"
							   Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
							   Text="Pick a recent one"/>

					<StackPanel x:Name="RecentLocationsStackPanel"
								Orientation="Vertical">
						<!-- Dynamic content here -->
					</StackPanel>

				</StackPanel>
			</Grid>
		</ScrollViewer>
	</Grid>
</Page>
