<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Aer.HomePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Aer"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Grid>
		<Grid x:Name="MainContent">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<!-- Header -->
				<RowDefinition Height="*" />
				<!-- Scrollable content -->
				<RowDefinition Height="Auto" />
				<!-- Footer -->
			</Grid.RowDefinitions>

			<StackPanel x:Name="HeaderPanel"
						Grid.Row="0"
						Orientation="Vertical"
						Padding="24,18,24,0">
					<TextBlock x:Name="HeaderText"
							   Style="{StaticResource HeaderTextBlockStyle}"
							   HorizontalAlignment="Left"
							   Grid.Column="0"
							   Text="HeaderText" />
				<StackPanel Orientation="Horizontal">
					<FontIcon x:Name="SubHeaderIcon"
						  FontFamily="{StaticResource WeatherIconsFont}"
						  Glyph="&#xF00D;"
						  FontSize="13"
						  Margin="0,6.5,8,0"/>
					<TextBlock x:Name="SubHeaderText"
						   Style="{StaticResource BodyTextBlockStyle}"
						   Padding="0,8,0,0"
						   Text="SubHeaderText" />
				</StackPanel>
			</StackPanel>

			<ScrollViewer x:Name="Scroller"
						  Grid.Row="1"
						  Padding="24,16,24,0">
				<Grid>
					<StackPanel HorizontalAlignment="Stretch">
						<TextBlock x:Name="Content" Text="Content"/>
					</StackPanel>
				</Grid>
			</ScrollViewer>

			<TextBlock Grid.Row="2"
					   Style="{StaticResource CaptionTextBlockStyle}"
					   VerticalAlignment="Bottom"
					   HorizontalAlignment="Right"
					   HorizontalTextAlignment="Right"
					   Padding="0,0,24,16"
					   ToolTipService.ToolTip="Click to force-update from network">
				<Hyperlink Click="LastUpdateTimeTextHyperlink_Click"
						   TextDecorations="None"
						   IsTabStop="False">
					<Run x:Name="LastUpdateTimeText"
						 Text="Hello Footer"
						 TextDecorations="None" />
				</Hyperlink>
			</TextBlock>
		</Grid>
		
		<!-- Loading Overlay -->
		<Grid x:Name="LoadingOverlay"
			  Background="{ThemeResource LayerFillColorDefaultBrush}"
			  Opacity="0.6"
			  Visibility="Collapsed"
			  HorizontalAlignment="Stretch"
			  VerticalAlignment="Stretch">
			<ProgressRing IsActive="True"
						  Width="24"
						  Height="24"
						  HorizontalAlignment="Center"
						  VerticalAlignment="Center" />
		</Grid>
	</Grid>
</Page>
