<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Aer.HomePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Aer"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
	mc:Ignorable="d">

	<Grid>
		<Grid x:Name="MainContent">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<!-- Header -->
				<RowDefinition Height="*" />
				<!-- Scrollable content -->
				<RowDefinition Height="Auto" />
				<!-- Footer -->
			</Grid.RowDefinitions>

			<StackPanel x:Name="HeaderPanel"
						Grid.Row="0"
						Orientation="Vertical"
						Padding="24,18,24,0">
				<StackPanel Orientation="Horizontal">
					<TextBlock x:Name="HeaderText"
							   Style="{StaticResource HeaderTextBlockStyle}"
							   HorizontalAlignment="Left"
							   Grid.Column="0"
							   Text="HeaderText"
							   Padding="1,0,0,0"/>
					<FontIcon x:Name="CurrentConditionIcon"
						  FontFamily="{StaticResource WeatherIconsFont}"
						  Glyph="&#xF00D;"
						  FontSize="22"
						  Margin="14,0,2,0"
						  VerticalAlignment="Top"/>
				</StackPanel>
				<TextBlock x:Name="SubHeaderText"
						   Style="{StaticResource BodyTextBlockStyle}"
						   Padding="0,6,0,0"
						   Text="SubHeaderText" />
			</StackPanel>

			<ScrollViewer x:Name="Scroller"
						  Grid.Row="1"
						  Padding="0,16,0,0"
						  HorizontalScrollMode="Disabled"
						  VerticalScrollMode="Auto"
						  IsEnabled="False">
				<Grid x:Name="ContentGrid">
					<!-- A) Chart fills all space -->
					<win2d:CanvasControl x:Name="ContentChart"
										 ClearColor="Transparent"
										 Draw="ContentChartCanvas_Draw"
										 Visibility="Visible"
										 HorizontalAlignment="Stretch"
										 VerticalAlignment="Stretch" />
					<!-- B) Scrollable data text, initially hidden -->
					<TextBlock x:Name="ContentData"
							   Text="Data"
							   TextWrapping="Wrap"
							   FontFamily="Consolas"
							   Visibility="Collapsed"
							   Padding="24,0,24,0"/>
				</Grid>
			</ScrollViewer>

			<Grid Grid.Row="2"
				  HorizontalAlignment="Stretch"
				  Padding="8, 2, 0, 8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<SelectorBar x:Name="ContentSelectorBar"
							 Grid.Column="0"
							 SelectionChanged="ContentSelectorBar_SelectionChanged">
					<SelectorBarItem x:Name="ContentSelectorBar_ChartCard" Text="Chart" FontSize="12" Padding="16,8,16,2" IsSelected="True" />
					<SelectorBarItem x:Name="ContentSelectorBar_DataCard" Text="Data" FontSize="12" Padding="16,8,16,2" />
				</SelectorBar>
				<TextBlock
					   Grid.Column="1"
					   Style="{StaticResource CaptionTextBlockStyle}"
					   VerticalAlignment="Bottom"
					   HorizontalAlignment="Right"
					   HorizontalTextAlignment="Right"
					   Padding="0,0,24,8"
					   ToolTipService.ToolTip="Click to force-update from network">
					<Hyperlink Click="LastUpdateTimeTextHyperlink_Click"
							   TextDecorations="None"
							   IsTabStop="False">
						<Run x:Name="LastUpdateTimeText"
							 Text="Hello Footer"
							 TextDecorations="None" />
					</Hyperlink>
				</TextBlock>
			</Grid>
		</Grid>
		
		
		
		<!-- Loading Overlay -->
		<Grid x:Name="LoadingOverlay"
			  Background="{ThemeResource LayerFillColorDefaultBrush}"
			  Opacity="0.6"
			  Visibility="Collapsed"
			  HorizontalAlignment="Stretch"
			  VerticalAlignment="Stretch">
			<ProgressRing IsActive="True"
						  Width="24"
						  Height="24"
						  HorizontalAlignment="Center"
						  VerticalAlignment="Center" />
		</Grid>
	</Grid>
</Page>
